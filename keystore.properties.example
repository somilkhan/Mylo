# Copy to keystore.properties in the project root and fill in local values.
# This file is a template only; passwords and private keys must never be committed.
#
# The MYLO release key uses MYLO-release-key.jks with alias mylo-release.
# Keep the .jks file and this local properties file outside version control.
# Make at least two encrypted backups of the keystore and passwords.
#
# IMPORTANT: Android updates for app.mylo.music must keep the same signing identity.
# Losing this key can prevent future releases from updating existing MYLO installs.

storeFile=MYLO-release-key.jks
storePassword=
keyAlias=mylo-release
keyPassword=
